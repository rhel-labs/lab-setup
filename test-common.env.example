# Copy this file to /tmp/test-common.env (or set LAB_TEST_ENV to its path)
# and fill in values before running test-common-functions.sh.
#
# Credential-dependent tests are skipped when the relevant vars are absent —
# you do not need all of them to run a partial test.

# Non-root user for pull_public_images / pull_private_images user tests.
# Defaults to "rhel" if unset.
LAB_USER=

# Subscription Manager credentials — required for register_system_cdn and pin_rhel_release.
ACTIVATION_KEY=
ORG_ID=

# RHEL minor release to pin (e.g. 9.4, 10.2).
# Required for pin_rhel_release; skipped if unset.
RHEL_RELEASE=

# registry.redhat.io pull token (base64-encoded auth) — required for
# setup_redhat_registry_auth and pull_private_images.
REGISTRY_PULL_TOKEN=

# Git repo containing lab setup files — required for fetch_setup_files.
# GIT_BRANCH defaults to "main" if unset.
GIT_REPO=
GIT_BRANCH=

# Cockpit test values — defaults shown; override if your lab uses different names.
GUID=test-guid
DOMAIN=example.com
